{
  "id": "wf12toolhandoff",
  "name": "WF-12 Tool: handoff_to_human",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tool/handoff",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3a12000-0000-4000-8000-000000000001",
      "name": "Handoff Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "7d2b5e70-12a1-4f00-9b77-9c3e2e2e1201",
      "credentials": {
        "httpHeaderAuth": {
          "id": "hdrinternal01",
          "name": "SmartCS Internal Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO handoffs (idempotency_key, session_id, reason, summary)\n  VALUES ($1, $2, $3, $4)\n  ON CONFLICT (idempotency_key) DO NOTHING\n  RETURNING id, true AS created\n)\nSELECT * FROM ins\nUNION ALL\nSELECT id, false FROM handoffs WHERE idempotency_key = $1 AND NOT EXISTS (SELECT 1 FROM ins);",
        "options": {
          "queryReplacement": "={{ [$json.body.idempotency_key, $json.body.session_id, $json.body.reason, $json.body.summary] }}"
        }
      },
      "id": "c3a12000-0000-4000-8000-000000000002",
      "name": "Log Handoff",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgsmartcs01",
          "name": "SmartCS DB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3a12000-0000-4000-8000-0000000000c1",
              "leftValue": "={{ $('Log Handoff').item.json.created }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3a12000-0000-4000-8000-000000000003",
      "name": "New handoff?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.STAFF_TELEGRAM_CHAT_ID }}",
        "text": "={{ (() => { const b = $('Handoff Webhook').item.json.body; const chat = b.session_id.startsWith('tg_') ? b.session_id.slice(3) : ''; return '🙋 Khách cần nhân viên hỗ trợ\\nLý do: ' + b.reason + '\\nKênh: ' + b.channel + '\\nKhách: ' + b.session_id + (b.customer_phone ? ' · ' + b.customer_phone : '') + '\\n\\nTóm tắt: ' + b.summary + '\\n\\n' + (chat ? 'Trả lời khách: /reply ' + chat + ' <nội dung>' : '(Khách trên web, chưa hỗ trợ trả lời trực tiếp)'); })() }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "c3a12000-0000-4000-8000-000000000004",
      "name": "Notify Staff",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        -100
      ],
      "webhookId": "7d2b5e70-12a1-4f00-9b77-9c3e2e2e1202",
      "onError": "continueRegularOutput",
      "credentials": {
        "telegramApi": {
          "id": "tgcredsmartcs01",
          "name": "TechZone SmartCS Bot"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ queued: true }) }}",
        "options": {}
      },
      "id": "c3a12000-0000-4000-8000-000000000005",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Handoff Webhook": {
      "main": [
        [
          {
            "node": "Log Handoff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Handoff": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond": {
      "main": [
        [
          {
            "node": "New handoff?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New handoff?": {
      "main": [
        [
          {
            "node": "Notify Staff",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}